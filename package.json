{
  "name": "church-presenter",
  "productName": "Church Presenter",
  "version": "0.2.0",
  "description": "Scripture presenter with live sermon transcription (Phase 1: presenter core)",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n vite,app \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV=1 electron .\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --win",
    "test": "node shared/bibleRef.test.js && node shared/detector.test.js && node shared/bibleImport.test.js && node electron/yvoffline.test.cjs",
    "release": "vite build && electron-builder --win --publish always"
  },
  "build": {
    "appId": "org.church.presenter",
    "productName": "Church Presenter",
    "files": [
      "dist/**/*",
      "!dist/**/*.7z",
      "!dist/**/*.exe",
      "!dist/**/*.blockmap",
      "!dist/**/*.yml",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "extraResources": [
      {
        "from": "vendor/ndi",
        "to": "ndi",
        "filter": [
          "*.dll",
          "*.txt"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/koffi/**",
      "node_modules/@koromix/**",
      "node_modules/sherpa-onnx-*/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "elisagerafa900",
        "repo": "church-presenter-releases",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    }
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "koffi": "^3.3.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sherpa-onnx-node": "^2.0.1",
    "ws": "^8.22.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/elisagerafa900/church-presenter.git"
  },
  "author": "Elisha"
}
